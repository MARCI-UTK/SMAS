# Copy to .env (or export in your shell / systemd unit) and edit for your server.
# Every variable except SMAS_LOGIN_PASSWORD is optional; the values shown are the defaults in config.py.

# --- Flask app ---------------------------------------------------------------
# Optional. If unset, a random key is generated once and stored in instance/secret_key.
SMAS_SECRET_KEY=
SMAS_LOGIN_USERNAME=volfb
# REQUIRED. There is no default; login is disabled until this is set.
SMAS_LOGIN_PASSWORD=
MAX_UPLOAD_MB=1500
SMAS_APP_DATA_ROOT=./instance/player_data
SMAS_DATABASE_PATH=./instance/smas.sqlite3

# --- Scoring core (in this repo) ----------------------------------------------
# Defaults to core/smas_scoring_logic.py in this repository.
# SMAS_CORE_SCRIPT=/path/to/another/smas_scoring_logic.py

# --- External research code (NOT in this repo) -------------------------------
ATHLETE_CODES_DIR=/data/marci/mvenkat4/Athlete_Mesh_Analysis_Codes
SAM3D_DIR=/data/marci/mvenkat4/sam-3d-body
MHR_DIR=/data/marci/mvenkat4/MHR
SMPL_MODEL=/data/marci/mvenkat4/Athlete_Mesh_Analysis_Codes/SMPL_N_model_generate_from_npz.pkl

# --- Where the external pipeline reads inputs and writes outputs -------------
SPRINT_VIDEOS_DIR=/data/marci/mvenkat4/sprint_videos
ROLLOUT_ROOT=/data/marci/mvenkat4/outputs_with_moge2/rollout_results
SMPL_JSON_DIR=/data/marci/mvenkat4/sprint_smpl_dataset/data
LOWERBODY_JSON_DIR=/data/marci/mvenkat4/sprint_lowerbody_dataset/data

# --- Compute ---------------------------------------------------------------
CONDA_EXE=/data/marci/mvenkat4/miniconda3/bin/conda
CONDA_ENV=sam_3d_body
GPU_INDEX=0
